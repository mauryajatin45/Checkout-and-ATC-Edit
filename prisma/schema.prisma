generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id                  String                   @id @default(cuid())
  shopDomain          String                   @unique
  accessToken         String
  createdAt           DateTime                 @default(now())
  products            Product[]
  checkoutTimer       CheckoutTimerSettings?
  upsellCampaigns     CheckoutUpsellCampaign[]
  postPurchaseFunnels PostPurchaseFunnel[]
  thankYouCampaigns   ThankYouCampaign[]
}

model CheckoutTimerSettings {
  id              String  @id @default(cuid())
  storeId         String  @unique
  store           Store   @relation(fields: [storeId], references: [id])
  enabled         Boolean @default(true)
  text            String  @default("Due to high demand your order is reserved for:")
  timerMinutes    Int     @default(10)
  backgroundColor String  @default("#e8f8e8")
  textColor       String  @default("#000000")
  iconEnabled     Boolean @default(true)
  fontSize        String  @default("base")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  storeId          String
  shopifyProductId String
  title            String
  stickyAtcConfig  StickyAtcConfig?
  checkoutConfig   CheckoutConfig?
  store            Store            @relation(fields: [storeId], references: [id])
  customReviews    CustomReview[]
}

model StickyAtcConfig {
  id                String    @id @default(cuid())
  productId         String    @unique
  enabled           Boolean   @default(false)
  headline          String?
  subheadline       String?
  timerEnabled      Boolean   @default(false)
  timerMode         String    @default("fixed_end")
  timerEndAt        DateTime?
  autoResetTimer    Boolean   @default(true)
  backgroundColor   String?   @default("#B978D1")
  textColor         String    @default("#FFFFFF")
  iconColor         String    @default("#FFFFFF")
  timerBoxColor     String    @default("#FFFFFF")
  timerBoxTextColor String    @default("#B978D1")
  buttonText        String?   @default("Add to Cart")
  product           Product   @relation(fields: [productId], references: [id])
}

model CheckoutConfig {
  id               String  @id @default(cuid())
  productId        String  @unique
  enabled          Boolean @default(false)
  showReviews      Boolean @default(true)
  showRating       Boolean @default(true)
  reviewsSource    String  @default("judgeme")
  checkoutImageUrl String?

  product Product @relation(fields: [productId], references: [id])
}

model CustomReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  rating    Int
  title     String?
  body      String   @db.Text
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckoutUpsellCampaign {
  id              String               @id @default(cuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean              @default(true)
  sourcePage      String
  headline        String?              @default("Special Offer Just for You")
  description     String?
  buttonColor     String?              @default("#0066cc")
  buttonTextColor String?              @default("#ffffff")
  priority        Int                  @default(0)
  items           CheckoutUpsellItem[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([storeId])
}

model CheckoutUpsellItem {
  id                 String                 @id @default(cuid())
  campaignId         String
  campaign           CheckoutUpsellCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopifyProductId   String
  shopifyVariantId   String
  customTitle        String?
  customDescription  String?
  strikethroughPrice String?
  price              String?
  imageUrl           String?
  position           Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([campaignId])
}

// ─── Post-purchase (one-click upsell page between payment and the thank-you page) ───

model PostPurchaseFunnel {
  id              String              @id @default(cuid())
  storeId         String
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean             @default(false)
  priority        Int                 @default(0)
  // "all" = every eligible order, "products" = order contains one of triggerProductIds
  triggerType     String              @default("products")
  // JSON array of { id: "gid://shopify/Product/..", title }
  triggerProducts String?             @db.Text
  // "any" | "subscriber" (a line in the order has a selling plan) | "onetime" (no line has one)
  buyerType       String              @default("any")
  // JSON arrays of { id: "gid://shopify/ProductVariant/..", title }: the order must contain one of
  // includeVariants (empty = no requirement) and none of excludeVariants
  includeVariants String?             @db.Text
  excludeVariants String?             @db.Text
  timerMinutes    Int                 @default(10)
  steps           PostPurchaseOffer[]
  events          PostPurchaseEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([storeId])
}

model PostPurchaseOffer {
  id              String              @id @default(cuid())
  funnelId        String
  funnel          PostPurchaseFunnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  position        Int                 @default(0)
  // "always" | "accepted" | "declined": shown after the previous step was accepted / declined
  showWhen        String              @default("always")
  skipIfInOrder   Boolean             @default(true)
  // Show "+ $X shipping" next to the price when Shopify adds shipping
  showShippingNote Boolean            @default(false)
  productId       String
  variantId       String
  productTitle    String
  variantTitle    String?
  imageUrl        String?             @db.Text
  variantPrice    String?
  compareAtPrice  String?
  discountPercent Float               @default(0)
  discountTitle   String              @default("Exclusive offer")
  maxQuantity     Int                 @default(3)
  badgeText       String?
  headline        String?
  subheadline     String?             @db.Text
  bullets         String?             @db.Text
  ratingText      String?
  guaranteeText   String?             @db.Text
  acceptLabel     String?
  declineLabel    String?
  events          PostPurchaseEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([funnelId])
}

model PostPurchaseEvent {
  id          String             @id @default(cuid())
  storeId     String
  funnelId    String
  funnel      PostPurchaseFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       PostPurchaseOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  // "view" | "accept" | "decline" | "error"
  type        String
  referenceId String?
  quantity    Int?
  revenue     Float?
  currency    String?
  detail      String?            @db.Text
  createdAt   DateTime           @default(now())

  @@index([storeId, createdAt])
  @@index([funnelId, type])
  @@index([offerId])
}

// ─── Thank-you page offer (block on the Thank you page; "Buy now" opens a prefilled new checkout) ───

model ThankYouCampaign {
  id              String          @id @default(cuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean         @default(false)
  priority        Int             @default(0)
  // "all" = every order, "products" = order contains one of triggerProducts
  triggerType     String          @default("all")
  // JSON array of { id: "gid://shopify/Product/..", title }
  triggerProducts String?         @db.Text
  timerMinutes    Int             @default(10)
  badgeText       String?
  headline        String?
  subheadline     String?         @db.Text
  buttonLabel     String?
  smallPrint      String?         @db.Text
  // Optional Shopify discount code applied to the new checkout, and the % it gives (for display only)
  discountCode    String?
  discountPercent Float           @default(0)
  items           ThankYouItem[]
  events          ThankYouEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([storeId])
}

model ThankYouItem {
  id             String           @id @default(cuid())
  campaignId     String
  campaign       ThankYouCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  position       Int              @default(0)
  productId      String
  variantId      String
  productTitle   String
  variantTitle   String?
  imageUrl       String?          @db.Text
  variantPrice   String?
  compareAtPrice String?
  maxQuantity    Int              @default(3)
  skipIfInOrder  Boolean          @default(false)
  // Show "+ shipping" next to the price
  showShippingNote Boolean         @default(false)
  events         ThankYouEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([campaignId])
}

model ThankYouEvent {
  id          String           @id @default(cuid())
  storeId     String
  campaignId  String
  campaign    ThankYouCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  itemId      String?
  item        ThankYouItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  // "view" | "click"
  type        String
  referenceId String?
  quantity    Int?
  createdAt   DateTime         @default(now())

  @@index([storeId, createdAt])
  @@index([campaignId, type])
  @@index([itemId])
}

// ─── Diagnostics: every call from a checkout extension (post-purchase / thank-you) to our API ───
model ExtensionLog {
  id        String   @id @default(cuid())
  shop      String?
  path      String
  method    String
  status    Int
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}
