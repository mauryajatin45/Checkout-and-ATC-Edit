generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  accessToken String
  createdAt   DateTime @default(now())
  products    Product[]
}

model Product {
  id               String   @id @default(cuid())
  storeId          String
  shopifyProductId String
  title            String
  stickyAtcConfig  StickyAtcConfig?
  checkoutConfig   CheckoutConfig?
  store            Store    @relation(fields: [storeId], references: [id])
}

model StickyAtcConfig {
  id               String   @id @default(cuid())
  productId        String   @unique
  enabled          Boolean  @default(false)
  headline         String?
  subheadline      String?
  timerEnabled     Boolean  @default(false)
  timerMode        String   @default("fixed_end")
  timerEndAt       DateTime?
  autoResetTimer   Boolean  @default(true)
  backgroundColor  String?  @default("#B978D1")
  textColor        String   @default("#FFFFFF")
  buttonText       String?  @default("Add to Cart")
  product          Product  @relation(fields: [productId], references: [id])
}

model CheckoutConfig {
  id               String   @id @default(cuid())
  productId        String   @unique
  enabled          Boolean  @default(false)
  showReviews      Boolean  @default(true)
  showRating       Boolean  @default(true)
  product          Product  @relation(fields: [productId], references: [id])
}
